# Salin file ini menjadi ".env" (di folder yang sama dengan manage.py), lalu isi nilainya.
# JANGAN membagikan file .env dan jangan mengunggahnya ke GitHub.

# Kunci rahasia Django (buat dengan perintah di PANDUAN.md). Pakai tanda kutip tunggal.
DJANGO_SECRET_KEY='isi-dengan-kunci-acak'
DJANGO_DEBUG=True

# Database PostgreSQL
DB_NAME=db_listrik
DB_USER=postgres
DB_PASSWORD=isi_password_postgres_kamu
DB_HOST=localhost
DB_PORT=5432

# Google Gemini (nilai API Key sama dengan secret P09 di Google Colab)
GEMINI_API_KEY=isi_api_key_gemini_kamu
GEMINI_MODEL=gemini-3.8-flash
